        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(flask_http_request_total{service=\"sut\"}[1m]))",
          "legendFormat": "rps"
